// DNR Rules - Declarative Net Request rules for blocking tracking scripts
// that inject app banners. These are network-level blocks.

[
  {
    "id": 1,
    "priority": 1,
    "action": { "type": "block" },
    "condition": {
      "urlFilter": "||cdn.jsdelivr.net/npm/@reddit/app-banner*",
      "resourceTypes": ["script"]
    }
  },
  {
    "id": 2,
    "priority": 1,
    "action": { "type": "block" },
    "condition": {
      "urlFilter": "||platform.twitter.com/widgets.js",
      "resourceTypes": ["script"],
      "domains": ["twitter.com", "x.com"]
    }
  },
  {
    "id": 3,
    "priority": 1,
    "action": { "type": "block" },
    "condition": {
      "urlFilter": "||connect.facebook.net/en_US/sdk.js",
      "resourceTypes": ["script"]
    }
  },
  {
    "id": 4,
    "priority": 1,
    "action": { "type": "block" },
    "condition": {
      "urlFilter": "||assets.tiktok.com/webcast/*/app-banner*",
      "resourceTypes": ["script"]
    }
  },
  {
    "id": 5,
    "priority": 1,
    "action": { "type": "block" },
    "condition": {
      "urlFilter": "||static.xx.fbcdn.net/rsrc.php/*/app_banner*",
      "resourceTypes": ["script"]
    }
  },
  {
    "id": 6,
    "priority": 1,
    "action": { "type": "block" },
    "condition": {
      "urlFilter": "||cdn.linkedin.com/app-banner*",
      "resourceTypes": ["script"]
    }
  },
  {
    "id": 7,
    "priority": 1,
    "action": { "type": "block" },
    "condition": {
      "urlFilter": "||pinimg.com/app-banner*",
      "resourceTypes": ["script"]
    }
  },
  {
    "id": 8,
    "priority": 1,
    "action": { "type": "block" },
    "condition": {
      "urlFilter": "||cdn.medium.com/app-banner*",
      "resourceTypes": ["script"]
    }
  },
  {
    "id": 9,
    "priority": 1,
    "action": { "type": "block" },
    "condition": {
      "urlFilter": "||cdn.quora.com/app-banner*",
      "resourceTypes": ["script"]
    }
  },
  {
    "id": 10,
    "priority": 1,
    "action": { "type": "block" },
    "condition": {
      "urlFilter": "||stackoverflow.com/app-banner*",
      "resourceTypes": ["script"]
    }
  },
  {
    "id": 11,
    "priority": 1,
    "action": { "type": "block" },
    "condition": {
      "urlFilter": "||github.githubassets.com/app-banner*",
      "resourceTypes": ["script"]
    }
  },
  {
    "id": 12,
    "priority": 1,
    "action": { "type": "block" },
    "condition": {
      "urlFilter": "||www.googleadservices.com/pagead/conversion*",
      "resourceTypes": ["script", "xmlhttprequest"]
    }
  },
  {
    "id": 13,
    "priority": 1,
    "action": { "type": "block" },
    "condition": {
      "urlFilter": "||googletagmanager.com/gtag/js?id=*",
      "resourceTypes": ["script"]
    }
  },
  {
    "id": 14,
    "priority": 1,
    "action": { "type": "block" },
    "condition": {
      "urlFilter": "||connect.facebook.net/*/fbevents.js",
      "resourceTypes": ["script"]
    }
  },
  {
    "id": 15,
    "priority": 1,
    "action": { "type": "block" },
    "condition": {
      "urlFilter": "||snap.licdn.com/li.lms-analytics/insight.min.js",
      "resourceTypes": ["script"]
    }
  }
]